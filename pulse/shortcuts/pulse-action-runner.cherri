/*
  Pulse Action Runner.

  HUMAN CHECK: this source is intentionally kept as an import template until
  Cherri can be run on macOS/iPhone and native Calendar/Reminders action names
  are verified. It is not presented by Pulse as an installable signed Shortcut.

  The server only returns the allowlisted action types documented below. The
  Shortcut must never evaluate arbitrary server text as a command.
*/
#include 'actions/calendar'
#include 'actions/reminders'
#include 'actions/web'

#define name Pulse Action Runner
#define color blue

const pulseURL = "https://pulse.moralife.uk"
const pulseToken = "REPLACE_WITH_SHORTCUT_TOKEN"
const headers = {"X-Pulse-Shortcut-Token": pulseToken}
const pending = jsonRequest(pulseURL + "/api/shortcut/actions/next", "GET", {}, headers)
const action = pending.action

if (action) {
  const claimed = jsonRequest(pulseURL + "/api/shortcut/actions/" + action.id + "/claim", "POST", {}, headers)
  if (claimed.action) {
    const actionHeaders = {"X-Pulse-Shortcut-Token": pulseToken, "X-Pulse-Action-Claim": claimed.action.claim_token}
    if (action.action_type == "create_calendar_event") {
      const created = addCalendarEvent(action.payload.title, action.payload.start, action.payload.end, action.payload.location, action.payload.notes, action.payload.calendar_name)
      jsonRequest(pulseURL + "/api/shortcut/actions/" + action.id + "/complete", "POST", {"result": {"event_identifier": created.identifier}}, actionHeaders)
    } else if (action.action_type == "create_reminder") {
      const created = addReminder(action.payload.title, action.payload.due, action.payload.list, action.payload.notes, action.payload.priority)
      jsonRequest(pulseURL + "/api/shortcut/actions/" + action.id + "/complete", "POST", {"result": {"reminder_identifier": created.identifier}}, actionHeaders)
    } else if (action.action_type == "open_url") {
      openURL(action.payload.url)
      jsonRequest(pulseURL + "/api/shortcut/actions/" + action.id + "/complete", "POST", {"result": {"opened": true}}, actionHeaders)
    } else if (action.action_type == "refresh_context") {
      jsonRequest(pulseURL + "/api/shortcut/context", "POST", {"mode": "unknown", "state": "awake", "confidence": 0.6, "signals": {"shortcut": {"runner": true}}}, headers)
      jsonRequest(pulseURL + "/api/shortcut/actions/" + action.id + "/complete", "POST", {"result": {"context_sent": true}}, actionHeaders)
    } else {
      jsonRequest(pulseURL + "/api/shortcut/actions/" + action.id + "/fail", "POST", {"error": "unsupported_action_type"}, actionHeaders)
    }
  }
}
