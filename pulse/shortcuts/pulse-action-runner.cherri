#define name Pulse Action Runner
#include 'actions/scripting'
#question pulseToken "Paste your Pulse Shortcut token" ""

@token = text(pulseToken)
@headers = {"X-Pulse-Shortcut-Token": "PLACEHOLDER"}
setValue(@headers, "X-Pulse-Shortcut-Token", @token)

@pending = rawAction("is.workflow.actions.downloadurl", {
  "WFURL": "https://pulse.moralife.uk/api/shortcut/actions/next",
  "WFHTTPMethod": "GET",
  "WFHTTPHeaders": "${@headers}"
})
@pendingJSON = getDictionary(@pending)
@action = getDictionary(@pendingJSON['action'])
@actionID: text
@actionID = @action['id']

if @actionID != "" {
  @claimURL = "https://pulse.moralife.uk/api/shortcut/actions/{@actionID}/claim"
  @claim = rawAction("is.workflow.actions.downloadurl", {
    "WFURL": "{@claimURL}",
    "WFHTTPMethod": "POST",
    "WFHTTPHeaders": "${@headers}",
    "WFHTTPBodyType": "JSON",
    "WFJSONValues": {}
  })
  @claimJSON = getDictionary(@claim)
  @claimed = getDictionary(@claimJSON['action'])
  @claimToken: text
  @claimToken = @claimed['claim_token']

  if @claimToken != "" {
    @actionHeaders = {"X-Pulse-Shortcut-Token": "{@token}", "X-Pulse-Action-Claim": "{@claimToken}"}
    @payload = @action['payload']
    @actionType: text
    @actionType = @action['action_type']

    if @actionType == "create_calendar_event" {
      rawAction("is.workflow.actions.createevent", {
        "WFCalendarEventTitle": "{@payload['title']}",
        "WFCalendarEventStartDate": "{@payload['start']}",
        "WFCalendarEventEndDate": "{@payload['end']}",
        "WFCalendarEventLocation": "{@payload['location']}",
        "WFCalendarEventNotes": "{@payload['notes']}",
        "WFCalendarEventCalendar": "{@payload['calendar_name']}"
      })
      @result = {"event_identifier": "created-by-pulse"}
      @completeURL = "https://pulse.moralife.uk/api/shortcut/actions/{@actionID}/complete"
      rawAction("is.workflow.actions.downloadurl", {
        "WFURL": "{@completeURL}",
        "WFHTTPMethod": "POST",
        "WFHTTPHeaders": "${@actionHeaders}",
        "WFHTTPBodyType": "JSON",
        "WFJSONValues": {"result": "${@result}"}
      })
    } else if @actionType == "create_reminder" {
      rawAction("is.workflow.actions.reminders", {
        "WFReminderTitle": "{@payload['title']}",
        "WFReminderDueDate": "{@payload['due']}",
        "WFReminderNotes": "{@payload['notes']}",
        "WFReminderPriority": "{@payload['priority']}",
        "WFReminderList": "{@payload['list']}"
      })
      @result = {"reminder_identifier": "created-by-pulse"}
      @completeURL = "https://pulse.moralife.uk/api/shortcut/actions/{@actionID}/complete"
      rawAction("is.workflow.actions.downloadurl", {
        "WFURL": "{@completeURL}",
        "WFHTTPMethod": "POST",
        "WFHTTPHeaders": "${@actionHeaders}",
        "WFHTTPBodyType": "JSON",
        "WFJSONValues": {"result": "${@result}"}
      })
    } else if @actionType == "open_url" {
      rawAction("is.workflow.actions.openurl", {"WFURL": "{@payload['url']}"})
      @completeURL = "https://pulse.moralife.uk/api/shortcut/actions/{@actionID}/complete"
      rawAction("is.workflow.actions.downloadurl", {
        "WFURL": "{@completeURL}",
        "WFHTTPMethod": "POST",
        "WFHTTPHeaders": "${@actionHeaders}",
        "WFHTTPBodyType": "JSON",
        "WFJSONValues": {"result": {"opened": true}}
      })
    } else if @actionType == "refresh_context" {
      rawAction("is.workflow.actions.downloadurl", {
        "WFURL": "https://pulse.moralife.uk/api/shortcut/context",
        "WFHTTPMethod": "POST",
        "WFHTTPHeaders": "${@headers}",
        "WFHTTPBodyType": "JSON",
        "WFJSONValues": {"mode": "unknown", "state": "awake", "confidence": 0.6, "signals": {"shortcut": {"runner": true}}}
      })
      @completeURL = "https://pulse.moralife.uk/api/shortcut/actions/{@actionID}/complete"
      rawAction("is.workflow.actions.downloadurl", {
        "WFURL": "{@completeURL}",
        "WFHTTPMethod": "POST",
        "WFHTTPHeaders": "${@actionHeaders}",
        "WFHTTPBodyType": "JSON",
        "WFJSONValues": {"result": {"context_sent": true}}
      })
    } else {
      @failURL = "https://pulse.moralife.uk/api/shortcut/actions/{@actionID}/fail"
      rawAction("is.workflow.actions.downloadurl", {
        "WFURL": "{@failURL}",
        "WFHTTPMethod": "POST",
        "WFHTTPHeaders": "${@actionHeaders}",
        "WFHTTPBodyType": "JSON",
        "WFJSONValues": {"error": "unsupported_action_type"}
      })
    }
  }
}
