/*
   Thin optional Shortcut for Pulse.

   The server owns source rules, quiet hours, and relevance. This Shortcut only
   sends current phone context to the server and displays the returned result.
   Replace the token before compiling. Do not commit a real token.
*/
#include 'actions/device'
#include 'actions/location'
#include 'actions/web'

#define name Pulse phone context
#define color blue

const currentLocationValue = getCurrentLocation()
const latitude = getLocationDetail(currentLocationValue, 'Latitude')
const longitude = getLocationDetail(currentLocationValue, 'Longitude')
const context = {
  "mode": "outside",
  "confidence": 0.8,
  "signals": {
    "battery": {"level": getBatteryLevel(), "charging": isCharging()},
    "location": {"latitude": latitude, "longitude": longitude}
  }
}
const response = jsonRequest(
  "https://pulse.moralife.uk/api/shortcut/context",
  "POST",
  context,
  {"X-Pulse-Shortcut-Token": "REPLACE_WITH_SHORTCUT_TOKEN"}
)
show(response)
