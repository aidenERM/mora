#define name Pulse Phone Context
#include 'actions/scripting'
#question pulseToken "Paste your Pulse Shortcut token" ""

@token = text(pulseToken)
@headers = {"X-Pulse-Shortcut-Token": "PLACEHOLDER"}
setValue(@headers, "X-Pulse-Shortcut-Token", @token)
@battery = rawAction("is.workflow.actions.getbatterylevel")
@charging = rawAction("is.workflow.actions.ischarging")
@location = rawAction("is.workflow.actions.currentlocation")
@response = rawAction("is.workflow.actions.downloadurl", {
  "WFURL": "https://pulse.moralife.uk/api/shortcut/context",
  "WFHTTPMethod": "POST",
  "WFHTTPHeaders": "${@headers}",
  "WFHTTPBodyType": "JSON",
  "WFJSONValues": {
    "mode": "unknown",
    "physical_context": "unknown",
    "state": "awake",
    "confidence": 0.6,
    "signals": {
      "battery": {"level": "${@battery}", "charging": "${@charging}"},
      "location": "${@location}"
    }
  }
})
show(@response)
