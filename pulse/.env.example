# production location and storage
PULSE_ENV=production
PULSE_APP_URL=https://pulse.moralife.uk
PULSE_BIND=127.0.0.1:8791
PULSE_DATABASE_PATH=/var/lib/pulse/pulse.sqlite3
PULSE_TIMEZONE=America/Bogota
PULSE_TRUST_PROXY=1
PULSE_COOKIE_SECURE=1

# generate with: python -m pulse_app.cli secret
PULSE_SECRET_KEY=replace-with-a-long-random-secret
# generate with: python -m pulse_app.cli password
PULSE_PASSWORD_HASH=replace-with-output-from-the-password-command

# generate with: python -m pulse_app.cli vapid
PULSE_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
PULSE_VAPID_PRIVATE_KEY=replace-with-vapid-private-key
PULSE_VAPID_SUBJECT=mailto:you@example.com

# worker rules
PULSE_POLL_MINUTES=15
PULSE_QUIET_START=23:00
PULSE_QUIET_END=07:00
PULSE_QUIET_BYPASS_PRIORITY=98
# These are deliberately conservative. Lower stored topic preferences cannot bypass the server floors.
PULSE_TOPIC_THRESHOLDS_JSON={"weather":88,"warzone":84,"apple":88,"github":82,"colombia":90,"watcher":88,"earthquake":92,"package":86}
PULSE_STRICT_MIN_THRESHOLDS_JSON={"weather":88,"warzone":84,"apple":88,"github":82,"colombia":90,"watcher":88,"earthquake":92,"package":86}
PULSE_NOTIFICATION_COOLDOWNS_JSON={"weather":180,"warzone":120,"apple":180,"github":120,"colombia":240,"watcher":240,"earthquake":60,"package":360}
PULSE_NOTIFICATION_MAX_AGE_JSON={"weather":180,"warzone":1440,"apple":1440,"github":2880,"colombia":720,"watcher":720,"earthquake":360,"package":1440}
PULSE_MAX_NOTIFICATIONS_PER_RUN=2
PULSE_URGENT_NOTIFY_SCORE=98
PULSE_MORNING_CATCHUP_ENABLED=1
PULSE_MORNING_CATCHUP_WINDOW_MINUTES=60
PULSE_ROLLING_NOTIFICATION_LIMITS_JSON={"global":{"count":4,"minutes":60},"topic":{"count":2,"minutes":180},"tier":{}}
PULSE_TOPIC_COOLING_JSON={"window_minutes":180,"trigger_count":3,"threshold_step":4,"max_threshold_bonus":12,"decay_minutes":360}
PULSE_DEVELOPMENT_OVERRIDE_DELTA=8
PULSE_TREND_WINDOW_HOURS=72

# default weather location is La Ceja, Antioquia. replace these if needed.
PULSE_WEATHER_LAT=6.03131
PULSE_WEATHER_LON=-75.43333
PULSE_WEATHER_LABEL=La Ceja, Antioquia
PULSE_WEATHER_LOOKAHEAD_HOURS=24
PULSE_WEATHER_HOT_C=28
PULSE_WEATHER_COLD_C=12
PULSE_WEATHER_RAIN_PROBABILITY=75
PULSE_WEATHER_RAIN_MM=5
PULSE_WEATHER_WIND_KMH=50

# USGS feed is checked with the same 15-minute worker, but only local-impact or major events can notify.
PULSE_EARTHQUAKE_ENABLED=1
PULSE_EARTHQUAKE_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
PULSE_EARTHQUAKE_LOCAL_RADIUS_KM=400
PULSE_EARTHQUAKE_LOCAL_MIN_MAG=4.5
PULSE_EARTHQUAKE_MAJOR_MAG=6.5

# public GitHub repositories, comma-separated. Keep tokens server-side.
PULSE_GITHUB_REPOS=
PULSE_GITHUB_TOKEN=
# optional signed webhook secret for repositories you control
PULSE_GITHUB_WEBHOOK_SECRET=

# optional web discovery. the key is read only by the server and never sent to the PWA.
# Brave Search is disabled when this is blank.
PULSE_BRAVE_SEARCH_API_KEY=
PULSE_DISCOVERY_INTERVAL_MINUTES=180
PULSE_DISCOVERY_MAX_QUERIES=5
PULSE_DISCOVERY_MAX_RESULTS=5
PULSE_DISCOVERY_FRESHNESS=pw
PULSE_DISCOVERY_ON_WATCHER=1
# Leave these blank to use Pulse's built-in profiles/entities, or provide JSON arrays.
PULSE_SEARCH_PROFILES_JSON=
PULSE_TRACKED_ENTITIES_JSON=

# Optional custom source arrays. Each item needs id, url, topic, and keywords.
# Example: [{"id":"my-feed","url":"https://example.com/feed.xml","topic":"watcher","keywords":["release","outage"]}]
PULSE_RSS_SOURCES_JSON=[]
PULSE_URL_WATCHERS_JSON=[]
# Package tracking uses a server-side tracking page URL and only surfaces meaningful status changes.
# Example: [{"id":"my-package","label":"new phone","package_id":"tracking-number","url":"https://carrier.example/track/123"}]
PULSE_PACKAGE_WATCHERS_JSON=[]
PULSE_COLOMBIA_RSS_URL=https://news.google.com/rss/search?q=Colombia&hl=es-419&gl=CO&ceid=CO:es-419

# optional thin Shortcut endpoint. Store this token in the Shortcut only if you enable it.
PULSE_SHORTCUT_TOKEN=

# encrypted server-side integration tokens. generate a Fernet key; never commit the real value.
PULSE_TOKEN_ENCRYPTION_KEY=generate-with-Fernet-generate_key

# optional AWS Bedrock classification/summarization. credentials stay on the server.
PULSE_AWS_REGION=us-east-1
PULSE_AWS_ACCESS_KEY_ID=
PULSE_AWS_SECRET_ACCESS_KEY=
PULSE_BEDROCK_MODEL_ID=openai.gpt-5.6-luna
PULSE_BEDROCK_FALLBACK_MODEL_ID=

# official Google OAuth for Gmail and Calendar read-only access.
PULSE_GOOGLE_CLIENT_ID=
PULSE_GOOGLE_CLIENT_SECRET=
PULSE_GOOGLE_REDIRECT_URI=https://pulse.moralife.uk/api/integrations/google/callback

# official Discord OAuth. Pulse only requests identify/guilds and never uses user tokens.
PULSE_DISCORD_CLIENT_ID=
PULSE_DISCORD_CLIENT_SECRET=
PULSE_DISCORD_REDIRECT_URI=https://pulse.moralife.uk/api/integrations/discord/callback
