# production location and storage
PULSE_ENV=production
PULSE_APP_URL=https://pulse.moralife.uk
PULSE_BIND=127.0.0.1:8791
PULSE_DATABASE_PATH=/var/lib/pulse/pulse.sqlite3
PULSE_TIMEZONE=America/Bogota
PULSE_TRUST_PROXY=1
PULSE_COOKIE_SECURE=1

# generate with: python -m pulse_app.cli secret
PULSE_SECRET_KEY=replace-with-a-long-random-secret
# generate with: python -m pulse_app.cli password
PULSE_PASSWORD_HASH=replace-with-output-from-the-password-command

# generate with: python -m pulse_app.cli vapid
PULSE_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
PULSE_VAPID_PRIVATE_KEY=replace-with-vapid-private-key
PULSE_VAPID_SUBJECT=mailto:you@example.com

# worker rules
PULSE_POLL_MINUTES=15
PULSE_QUIET_START=23:00
PULSE_QUIET_END=07:00
PULSE_QUIET_BYPASS_PRIORITY=90
PULSE_TOPIC_THRESHOLDS_JSON={"weather":60,"warzone":72,"apple":78,"github":65,"colombia":84,"watcher":80}

# default weather location is La Ceja, Antioquia. replace these if needed.
PULSE_WEATHER_LAT=6.03131
PULSE_WEATHER_LON=-75.43333
PULSE_WEATHER_LABEL=La Ceja, Antioquia

# public GitHub repositories, comma-separated. Keep tokens server-side.
PULSE_GITHUB_REPOS=
PULSE_GITHUB_TOKEN=

# Optional custom source arrays. Each item needs id, url, topic, and keywords.
# Example: [{"id":"my-feed","url":"https://example.com/feed.xml","topic":"watcher","keywords":["release","outage"]}]
PULSE_RSS_SOURCES_JSON=[]
PULSE_URL_WATCHERS_JSON=[]
PULSE_COLOMBIA_RSS_URL=https://news.google.com/rss/search?q=Colombia&hl=es-419&gl=CO&ceid=CO:es-419

# optional thin Shortcut endpoint. Store this token in the Shortcut only if you enable it.
PULSE_SHORTCUT_TOKEN=
