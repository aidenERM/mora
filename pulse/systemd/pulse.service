[Unit]
Description=pulse.moralife.uk web app
After=network.target

[Service]
Type=simple
User=pulse
Group=pulse
WorkingDirectory=/opt/pulse/pulse
EnvironmentFile=/etc/pulse.env
ExecStart=/opt/pulse/.venv/bin/gunicorn --workers 1 --bind 127.0.0.1:8791 --access-logfile - pulse_app:create_app()
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/pulse

[Install]
WantedBy=multi-user.target
