[Unit]
Description=home.moralife.uk family chores
After=network.target

[Service]
Type=simple
User=home-moralife
Group=home-moralife
WorkingDirectory=/opt/home-moralife/family-chores
EnvironmentFile=/etc/home-moralife.env
ExecStart=/opt/home-moralife/.venv/bin/gunicorn --workers 1 --bind 127.0.0.1:8790 family_chores:create_app()
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/home-moralife

[Install]
WantedBy=multi-user.target

